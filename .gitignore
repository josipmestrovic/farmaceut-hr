# Ignore everything by default
/*

# Track Git configuration
!/.gitignore
!/.gitattributes

!/README.md

# GitHub Actions
!/.github/

# Composer (samo testne ovisnosti)
!/composer.json
!/composer.lock
!/phpunit.xml.dist
!/tests/
!/bin/

# Ignore Composer/vendor i lokalne testne artefakte (whitelist ih inače ne bi pratio)
/vendor/
/.phpunit.result.cache
/.php-cli.ini
/composer.phar
/.env
/.env.*

# Allow custom code directories
!/wp-content/
/wp-content/*

# Custom themes
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/farmaceut/

# Custom plugins — whitelist each farmaceut-* plugin explicitly when added
!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/farmaceut-cjenik/
