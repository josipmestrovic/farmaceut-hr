# Ignore everything by default
/*

# Track Git configuration
!/.gitignore

# Project docs
!/README.md
!/AGENTS.md

# GitHub Actions
!/.github/

# Allow custom code directories
!/wp-content/
/wp-content/*

# Custom themes
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/farmaceut/

# Custom plugins — whitelist each farmaceut-* plugin explicitly when added
!/wp-content/plugins/
/wp-content/plugins/*
